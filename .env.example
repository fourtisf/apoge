# ── API ─────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Leave unset for local dev to use an
# automatic in-memory MongoDB (mongodb-memory-server).
MONGO_URI=

# API port
PORT=4000

# Secret for signing short-lived session JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Allow the "demo wallet" (signature bypass) for local development.
# MUST be 0 (or unset) in production.
DEMO_MODE=1

# Password for the /admin panel. Unset = admin panel disabled.
ADMIN_PASSWORD=

# Public origin used in sitemap/canonical URLs.
PUBLIC_ORIGIN=https://apoge.fun

# Telegram ops notifications (new applications, whale buys, sale open/close).
# Create a bot with @BotFather, add it to a private group, set both. Unset = off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Phase 3 · on-chain settlement ───────────────────────────────────
# Deployed infrastructure per chain id (from packages/contracts deploys):
# ONCHAIN_CONTRACTS={"84532":{"staking":"0x…","usdc":"0x…","apg":"0x…"}}
ONCHAIN_CONTRACTS=
# Optional RPC overrides per chain id: {"84532":"https://…"}
ONCHAIN_RPC=
RPC_BASE_SEPOLIA=https://sepolia.base.org
# Deployer key for packages/contracts scripts (TESTNET ONLY — never a funded mainnet key)
DEPLOYER_KEY=

# RPC endpoints (Phase 1 uses them for balance reads only)
RPC_SOLANA=https://api.mainnet-beta.solana.com
RPC_ETH=https://eth.llamarpc.com
RPC_BASE=https://mainnet.base.org
RPC_BNB=https://bsc-dataseed.binance.org

# ── Web (Vite reads VITE_* from THIS root .env at build time) ──────
# WalletConnect v2 project id — free at https://cloud.reown.com
# Setting this enables the WalletConnect option (required for mobile wallets).
VITE_WALLETCONNECT_PROJECT_ID=
# Show the demo wallet connect option (local dev only)
VITE_DEMO_WALLET=1
